APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the exact URL you use in the browser (including 127.0.0.1 vs localhost).
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Use "database" locally on Windows; use "redis" in production with Horizon.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90
HORIZON_PREFIX=dfy_webinar_forge_horizon:
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_ALLOWED_EMAILS=
# Horizon workers (requires QUEUE_CONNECTION=redis and php artisan horizon)
HORIZON_TRAFFIC_MAX_PROCESSES=16
HORIZON_GENERAL_MAX_PROCESSES=8

# Resend (https://resend.com) – verify your sending domain in the Resend dashboard first.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"
# SMTP fallback (only if MAIL_MAILER=smtp)
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudinary – used for all AI-generated image uploads (promotion + ad creatives)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

VITE_APP_NAME="${APP_NAME}"

# Appearance — set true to allow light/dark/system in Settings → Appearance
APPEARANCE_DARK_MODE_ENABLED=false

# ─── Brand Mentions (Apify discovery + Zernio reply posting) ───────────────────

# Apify – powers Reddit, YouTube, News, and X/Twitter mention discovery
APIFY_API_TOKEN=
APIFY_ENABLED=true
APIFY_MAX_ITEMS_PER_SEARCH=25
# Reddit actor: sort=new for freshest first; time=year|month|week|day|hour|all (no exact 90-day option on Reddit)
APIFY_DEFAULT_SORT=new
APIFY_DEFAULT_TIME=year
# Drop any post older than this after Apify returns (safety net for commentable threads)
APIFY_MAX_POST_AGE_DAYS=90
APIFY_ACTOR_ID=practicaltools/apify-reddit-api
APIFY_YOUTUBE_ENABLED=true
# Official Apify Store actor (search by keyword). Alt: scraper_one/youtube-search-scraper
APIFY_YOUTUBE_ACTOR_ID=streamers/youtube-scraper
APIFY_YOUTUBE_TIMEOUT=300
APIFY_NEWS_ENABLED=true
APIFY_NEWS_ACTOR_ID=easyapi/google-news-scraper
APIFY_NEWS_MAX_ITEMS=100
APIFY_NEWS_LANGUAGE=lang_en
APIFY_NEWS_COUNTRY=us
APIFY_NEWS_TIMEOUT=240
# Twitter/X global keyword search (Apify discovers; Zernio posts replies)
APIFY_TWITTER_ENABLED=true
APIFY_TWITTER_ACTOR_ID=patient_discovery/twitter-search
APIFY_TWITTER_TIMEOUT=300
APIFY_TWITTER_COOLDOWN_SECONDS=900
APIFY_TWITTER_EXCLUDE_RETWEETS=true
APIFY_TWITTER_LANG=en

# Max auto-replies per connected social account per calendar day (all funnels combined)
TRAFFIC_AI_MAX_REPLIES_PER_DAY=20

# Funnel traffic: max keywords per funnel; auto-pause keyword when mention count reaches cap
MENTIONS_MAX_KEYWORDS_PER_FUNNEL=5
MENTIONS_MAX_RESULTS_PER_KEYWORD=500

# Zernio – social OAuth + posting replies (https://zernio.com)
ZERNIO_API_KEY=
ZERNIO_ENABLED=true
ZERNIO_BASE_URL=https://zernio.com/api
ZERNIO_DEFAULT_SOCIAL_ACCOUNT_ID=
ZERNIO_POST_ENDPOINT=/v1/posts

ADMIN_EMAILS=

# ─── Webinar AI, live chat, and URL scraping ───────────────────────────────────

SCRAPINGBEE_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Funnel Promotion (Phase 1 organic) ─────────────────────────────────────────
PROMOTION_ENABLED=true
PROMOTION_DEFAULT_TIMEZONE=UTC
PROMOTION_DEFAULT_SEQUENCE_SIZE=12
PROMOTION_MAX_SEQUENCE_SIZE=30
PROMOTION_QUEUE_GENERATE=promotion-generate
PROMOTION_QUEUE_PUBLISH=promotion-publish
PROMOTION_OPENAI_TEXT_MODEL=gpt-4o-mini
PROMOTION_OPENAI_IMAGE_MODEL=gpt-image-2
PROMOTION_OPENAI_TIMEOUT=90
# Set false to hide Paid Ads tab and Settings → Ad accounts
PAID_ADS_ENABLED=true
PROMOTION_ADS_MAX_GENERATED_CREATIVES=5
PROMOTION_ADS_MIN_BUDGET_AMOUNT=2

# D-ID avatar video generation (https://www.d-id.com)
# Get your API key at https://studio.d-id.com → Account → API Keys
DID_ENABLED=false
DID_API_KEY=
DID_TIMEOUT=120
DID_DEFAULT_VOICE_ID=en-US-JennyNeural
DID_DEFAULT_PRESENTER_URL=
DID_POLL_INTERVAL_SECONDS=15
DID_POLL_MAX_ATTEMPTS=60

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Local queue worker (see docs/queue-and-horizon.md) ─────────────────────────
# php artisan queue:work --queue=traffic-post,traffic-generate,traffic-evaluate,promotion-publish,promotion-generate,esp-dispatch,webinar-ai,default --tries=3 --sleep=1

# php artisan queue:work --queue=promotion-publish,promotion-generate